{
    "name": "sf-metascope-analyzer",
    "version": "1.0.0",
    "description": "Analyzes Salesforce DX projects (Apex, LWC, metadata) to help write documentation and understand code: dependencies, customizable HTML reports and an MCP server. Diffs and impact analysis are supported as a secondary use.",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "build": "ttsc && npm run build:report && npm run build:node",
        "build:node": "vite build --config vite.node.config.ts",
        "mcp": "ttsx --noCheck src/mcp/server.ts",
        "mcp:node": "node dist/node/mcp/server.js",
        "test": "ttsx --noCheck test/run.ts",
        "typecheck": "tsc --noEmit -p . && tsc -p tsconfig.test.json",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "build:report": "vite build --config vite.report.config.ts",
        "catalog": "ttsx --noCheck docs/catalog/generate.ts"
    },
    "keywords": [
        "salesforce",
        "metadata",
        "apex",
        "lwc",
        "documentation",
        "dependency-analysis",
        "report",
        "mcp"
    ],
    "author": "",
    "license": "ISC",
    "engines": {
        "node": ">=24.15"
    },
    "dependencies": {
        "@apexdevtools/apex-parser": "^5.2.0",
        "@babel/parser": "^8.0.7",
        "@dagrejs/dagre": "^3.1.3",
        "@json-render/core": "0.23.1",
        "@json-render/react": "0.23.1",
        "@json-render/shadcn": "0.23.1",
        "@lwc/compiler": "^9.5.3",
        "@lwc/shared": "^9.5.3",
        "@lwc/style-compiler": "^9.5.3",
        "@lwc/template-compiler": "^9.5.3",
        "@modelcontextprotocol/ext-apps": "1.7.5",
        "@modelcontextprotocol/sdk": "^1.30.0",
        "@xyflow/react": "^13.0.1",
        "lucide-react": "^1.73.0",
        "parse5": "^8.1.0",
        "postcss": "^8.5.30",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@lwc/engine-server": "^9.5.3",
        "@lwc/rollup-plugin": "^9.5.3",
        "@tailwindcss/vite": "^4.3.5",
        "@types/node": "^22.20.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "prettier": "^3.9.7",
        "rollup": "^4.68.4",
        "tailwindcss": "^4.3.5",
        "ttsc": "^0.32.1",
        "typescript": "^7.0.2",
        "vite": "^8.3.0",
        "vite-plugin-singlefile": "^2.0.2"
    }
}
