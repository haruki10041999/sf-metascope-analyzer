{
    "name": "sf-metascope-analyzer",
    "version": "1.0.0",
    "description": "Salesforce metadata analyzer with React Flow visualization and MCP server support",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "mcp": "tsx src/mcp/server.ts",
        "test": "tsx --test \"test/**/*.test.ts\"",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "keywords": [
        "salesforce",
        "metadata",
        "mcp",
        "react-flow"
    ],
    "author": "",
    "license": "ISC",
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "@apexdevtools/apex-parser": "^5.2.0",
        "@babel/parser": "^8.0.7",
        "@lwc/template-compiler": "^9.4.3",
        "@modelcontextprotocol/sdk": "^1.30.0",
        "dagre": "^0.8.5",
        "dotenv": "^17.4.2",
        "fast-xml-parser": "^5.11.2",
        "lucide-react": "^0.470.0",
        "postcss": "^8.5.30",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "reactflow": "^11.11.4",
        "typia": "^15.1.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/dagre": "^0.7.52",
        "@types/node": "^22.20.3",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "prettier": "^3.9.7",
        "tsx": "^4.23.13",
        "ttsc": "^0.32.1",
        "typescript": "^7.0.2",
        "vite": "^8.3.0",
        "vite-plugin-singlefile": "^2.0.2"
    }
}
