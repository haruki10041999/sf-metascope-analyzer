        "objectKey": "flow_965015269c4c235b",
        "context": "<Flow xmlns=\"http://soap.sforce.com/2006/04/metadata\">\n    <actionCalls>\n        <name>Notify</name>\n        <label>Notify</label>\n        <locationX>226</locationX>\n        <locationY>494</locationY>\n        <actionName>AccountService</actionName>\n        <actionType>apex</actionType>\n        <connector>\n            <targetReference>Log_Error</targetReference>\n        </connector>\n        <faultConnector>\n            <targetReference>Log_Error</targetReference>\n        </faultConnector>\n        <inputParameters>\n            <name>invoiceId</name>\n            <value>\n                <elementReference>$Record.Id</elementReference>\n            </value>\n        </inputParameters>\n    </actionCalls>\n    <apiVersion>62.0</apiVersion>\n    <assignments>\n        <name>Log_Error</name>\n        <label>Log Error</label>\n        <locationX>490</locationX>\n        <locationY>494</locationY>\n        <assignmentItems>\n            <assignToReference>errorMessage</assignToReference>\n            <operator>Assign</operator>\n            <value>\n                <stringValue>{!$Label.Invoice_Overdue}: {!$Flow.FaultMessage}</stringValue>\n            </value>\n        </assignmentItems>\n    </assignments>\n    <assignments>\n        <name>Orphan</name>\n        <label>Orphan</label>\n        <locationX>700</locationX>\n        <locationY>600</locationY>\n        <assignmentItems>\n            <assignToReference>Unknown_Var</assignToReference>\n            <operator>Assign</operator>\n            <value>\n                <booleanValue>true</booleanValue>\n            </value>\n        </assignmentItems>\n    </assignments>\n    <decisions>\n        <name>Check_Amount</name>\n        <label>Check Amount</label>\n        <locationX>358</locationX>\n        <locationY>278</locationY>\n        <defaultConnector>\n            <targetReference>Notify</targetReference>\n        </defaultConnector>\n        <defaultConnectorLabel>Small</defaultConnectorLabel>\n        <rules>\n            <name>Medium</name>\n            <conditionLogic>and</conditionLogic>\n            <conditions>\n                <leftValueReference>$Record.Amount__c</leftValueReference>\n                <operator>GreaterThan</operator>\n                <rightValue>\n                    <numberValue>1000.0</numberValue>\n                </rightValue>\n            </conditions>\n            <connector>\n                <targetReference>Notify</targetReference>\n            </connector>\n            <label>Medium</label>\n        </rules>\n        <rules>\n            <name>Large</name>\n            <conditionLogic>and</conditionLogic>\n            <conditions>\n                <leftValueReference>$Record.Amount__c</leftValueReference>\n                <operator>GreaterThan</operator>\n                <rightValue>\n                    <numberValue>50000.0</numberValue>\n                </rightValue>\n            </conditions>\n            <connector>\n                <targetReference>Set_Status</targetReference>\n            </connector>\n            <label>Large</label>\n        </rules>\n    </decisions>\n    <description>請求書の金額で状態を変える</description>\n    <environments>Default</environments>\n    <formulas>\n        <name>IsLarge</name>\n        <dataType>Boolean</dataType>\n        <expression>{!$Record.Amount__c} &gt; 50000</expression>\n    </formulas>\n    <interviewLabel>Invoice Status Update {!$Flow.CurrentDateTime}</interviewLabel>\n    <label>Invoice Status Update</label>\n    <processMetadataValues>\n        <name>BuilderType</name>\n        <value>\n            <stringValue>LightningFlowBuilder</stringValue>\n        </value>\n    </processMetadataValues>\n    <processMetadataValues>\n        <name>CanvasMode</name>\n        <value>\n            <stringValue>FREE_FORM_CANVAS</stringValue>\n        </value>\n    </processMetadataValues>\n    <processType>AutoLaunchedFlow</processType>\n    <recordUpdates>\n        <name>Set_Status</name>\n        <label>Set Status</label>\n        <locationX>226</locationX>\n        <locationY>386</locationY>\n        <faultConnector>\n            <targetReference>Log_Error</targetReference>\n        </faultConnector>\n        <inputAssignments>\n            <field>Status__c</field>\n            <value>\n                <stringValue>Approval</stringValue>\n            </value>\n        </inputAssignments>\n        <inputReference>$Record</inputReference>\n    </recordUpdates>\n    <start>\n        <locationX>232</locationX>\n        <locationY>0</locationY>\n        <connector>\n            <targetReference>Check_Amount</targetReference>\n        </connector>\n        <filterLogic>and</filterLogic>\n        <filters>\n            <field>Amount__c</field>\n            <operator>GreaterThanOrEqualTo</operator>\n            <value>\n                <numberValue>0.0</numberValue>\n            </value>\n        </filters>\n        <object>Invoice__c</object>\n        <recordTriggerType>CreateAndUpdate</recordTriggerType>\n        <triggerType>RecordAfterSave</triggerType>\n    </start>\n    <status>Active</status>\n    <triggerOrder>20</triggerOrder>\n    <variables>\n        <name>errorMessage</name>\n        <dataType>String</dataType>\n        <isCollection>false</isCollection>\n        <isInput>false</isInput>\n        <isOutput>true</isOutput>\n    </variables>\n</Flow>",
