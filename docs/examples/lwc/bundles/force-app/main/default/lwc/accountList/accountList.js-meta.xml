<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>取引先一覧</masterLabel>
    <description>親レコードに紐づく取引先の一覧</description>
    <targets>
        <target>lightning__RecordPage</target>
        <target>lightning__AppPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <property name="title" type="String" label="タイトル" default="取引先一覧"/>
            <property name="maxRows" type="Integer" label="最大件数" default="10" min="1" max="50"/>
            <objects>
                <object>Account</object>
            </objects>
            <supportedFormFactors>
                <supportedFormFactor type="Large"/>
                <supportedFormFactor type="Small"/>
            </supportedFormFactors>
        </targetConfig>
        <targetConfig targets="lightning__AppPage">
            <property name="title" type="String" label="タイトル"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
