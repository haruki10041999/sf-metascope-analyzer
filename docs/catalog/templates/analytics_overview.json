{
    "$schema": "../report-document.schema.json",
    "title": "分析",
    "data": {
        "analyticsUnits": {
            "provider": "metadata.units",
            "args": {
                "types": [
                    "report",
                    "reportType",
                    "dashboard"
                ]
            }
        },
        "analyticsProperties": {
            "provider": "metadata.properties",
            "args": {
                "types": [
                    "report",
                    "reportType",
                    "dashboard"
                ]
            }
        }
    },
    "spec": {
        "root": "page",
        "elements": {
            "summary": {
                "type": "Narrative",
                "props": {
                    "title": "概要",
                    "markdown": "(ここに概要を書く: どんなレポート・ダッシュボードがあり、どのレポートタイプ (オブジェクトと項目) を使っているか)"
                },
                "children": []
            },
            "analyticsUnitsTable": {
                "type": "DataTable",
                "props": {
                    "rows": {
                        "$state": "/data/analyticsUnits"
                    },
                    "columns": [
                        {
                            "key": "unitType",
                            "label": "種類"
                        },
                        {
                            "key": "name",
                            "label": "名前"
                        },
                        {
                            "key": "label",
                            "label": "ラベル"
                        },
                        {
                            "key": "description",
                            "label": "説明"
                        },
                        {
                            "key": "filePath",
                            "label": "ファイル"
                        }
                    ],
                    "caption": null,
                    "onlyChanged": false
                },
                "children": []
            },
            "analyticsUnitsCard": {
                "type": "Card",
                "props": {
                    "title": "レポート・レポートタイプ・ダッシュボード",
                    "description": null,
                    "maxWidth": "full",
                    "centered": null,
                    "className": null
                },
                "children": [
                    "analyticsUnitsTable"
                ]
            },
            "analyticsPropertiesTable": {
                "type": "DataTable",
                "props": {
                    "rows": {
                        "$state": "/data/analyticsProperties"
                    },
                    "columns": [
                        {
                            "key": "unitType",
                            "label": "種類"
                        },
                        {
                            "key": "name",
                            "label": "名前"
                        },
                        {
                            "key": "path",
                            "label": "場所"
                        },
                        {
                            "key": "value",
                            "label": "値"
                        }
                    ],
                    "caption": null,
                    "onlyChanged": false
                },
                "children": []
            },
            "analyticsPropertiesCard": {
                "type": "Card",
                "props": {
                    "title": "レポート・レポートタイプ・ダッシュボードの設定",
                    "description": "場所 → 値 (機密になりうる値は伏せた)",
                    "maxWidth": "full",
                    "centered": null,
                    "className": null
                },
                "children": [
                    "analyticsPropertiesTable"
                ]
            },
            "page": {
                "type": "Stack",
                "props": {
                    "direction": "vertical",
                    "gap": "lg",
                    "align": null,
                    "justify": null,
                    "className": null
                },
                "children": [
                    "summary",
                    "analyticsUnitsCard",
                    "analyticsPropertiesCard"
                ]
            }
        }
    }
}
